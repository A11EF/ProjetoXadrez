<Window x:Class="ProjetoXadrez.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projeto Xadrez"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#20242C">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#111318"
                BorderThickness="4"
                CornerRadius="3">
            <UniformGrid x:Name="ChessBoardGrid" Rows="8" Columns="8" Width="560" Height="560" />
        </Border>

        <Border Grid.Column="1"
                Margin="16,0,0,0"
                Padding="16"
                Background="#2D333D"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="XADREZ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <TextBlock Text="Jogada" Foreground="#ADB6C4" FontSize="13" />
                <TextBlock x:Name="TurnText" Text="1" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16" />

                <TextBlock Text="Vez de" Foreground="#ADB6C4" FontSize="13" />
                <TextBlock x:Name="PlayerText" Text="Brancas" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,16" />

                <TextBlock Text="Situação" Foreground="#ADB6C4" FontSize="13" />
                <TextBlock x:Name="StatusText" Text="Em jogo" Foreground="#7DD3FC" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,16" />

                <TextBlock Text="Peças capturadas" Foreground="#ADB6C4" FontSize="13" />
                <TextBlock x:Name="CapturedText" Text="Nenhuma" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,16" />

                <Button Content="Novo jogo"
                        Height="38"
                        Margin="0,8,0,0"
                        Click="NewGame_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
